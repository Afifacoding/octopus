{
  "name": "octopus",
  "version": "0.1.0",
  "private": true,
  "description": "OCTOPUS monorepo foundation",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @octopus/web",
    "dev:api": "npm run dev -w @octopus/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css,html,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css,html,yml,yaml}\"",
    "db:generate": "prisma generate --schema database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema database/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema database/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "prisma": "^6.14.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
