# Runtime
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
MAX_REQUEST_SIZE_BYTES=1048576
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SNAPSHOT_MAX_ARCHIVE_SIZE_BYTES=5242880
SNAPSHOT_MAX_FILE_COUNT=50000
SNAPSHOT_MAX_DIRECTORY_COUNT=10000
SNAPSHOT_MAX_PATH_LENGTH=512
SNAPSHOT_STORAGE_PROVIDER=local
SNAPSHOT_STORAGE_LOCAL_ROOT=.octopus-storage/snapshots
VAULT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/octopus

# Authentication
AUTH_SESSION_SECRET=replace-with-strong-session-secret
AUTH_OTP_SECRET=replace-with-strong-otp-secret
AUTH_PASSWORD_SALT_ROUNDS=12
AUTH_SESSION_TTL_HOURS=168
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

# Email OTP (SMTP)
# Development: leave these empty to enable API-based OTP fallback for local testing.
# Production: must be configured or API startup fails.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_FROM=

# Providers (placeholders only)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Web
VITE_API_BASE_URL=http://localhost:4000/api/v1
