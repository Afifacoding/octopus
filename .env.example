# Runtime
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
MAX_REQUEST_SIZE_BYTES=5242880
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SNAPSHOT_MAX_ARCHIVE_SIZE_BYTES=5242880
SNAPSHOT_MAX_FILE_COUNT=50000
SNAPSHOT_MAX_DIRECTORY_COUNT=10000
SNAPSHOT_MAX_PATH_LENGTH=512
SNAPSHOT_STORAGE_PROVIDER=local
SNAPSHOT_STORAGE_LOCAL_ROOT=.octopus-storage/snapshots
VAULT_ENCRYPTION_KEY=replace-with-32-byte-base64-key
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/octopus
# For project route integration tests, set TEST_DATABASE_URL to a dedicated local database ending in _test or -test.
# Route tests write records; never point TEST_DATABASE_URL at production or a shared development database.
# Project route integration tests require TEST_DATABASE_URL pointing to a dedicated local database
# whose name ends in _test or -test. Do not use the ordinary or production DATABASE_URL for those tests.

# Authentication
AUTH_SESSION_SECRET=replace-with-strong-session-secret
AUTH_OTP_SECRET=replace-with-strong-otp-secret
AUTH_PASSWORD_SALT_ROUNDS=12
AUTH_SESSION_TTL_HOURS=168
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

# Email OTP (Brevo Transactional Email API)
# Production: BREVO_API_KEY and EMAIL_FROM are required.
BREVO_API_KEY=
EMAIL_FROM=

# OCTOBOT AI provider (optional; configure one provider to enable model-backed replies)
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Storage providers (placeholders only)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Web
VITE_API_BASE_URL=http://localhost:4000/api/v1
