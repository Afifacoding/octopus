# Runtime
# Use NODE_ENV=production in Render. Production startup rejects missing or development secrets.
NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=4000
CORS_ORIGIN=http://localhost:5173
MAX_REQUEST_SIZE_BYTES=52428800
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
SNAPSHOT_MAX_ARCHIVE_SIZE_BYTES=31457280
SNAPSHOT_MAX_FILE_COUNT=50000
SNAPSHOT_MAX_DIRECTORY_COUNT=10000
SNAPSHOT_MAX_PATH_LENGTH=512
SNAPSHOT_MAX_TOTAL_BYTES=150000000
SNAPSHOT_STORAGE_PROVIDER=local
SNAPSHOT_STORAGE_LOCAL_ROOT=.octopus-storage/snapshots
# Generate a unique 32-byte key (base64 or 64 hex characters); back it up securely.
VAULT_ENCRYPTION_KEY=replace-with-a-generated-32-byte-base64-key
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/octopus
# Prisma migration/deployment connection; set to a non-pooling URL if your provider requires it.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/octopus
# For project route integration tests, use a dedicated local database ending in _test or -test.
# Route tests write records; never point TEST_DATABASE_URL at production or a shared development database.

# Authentication
AUTH_SESSION_SECRET=
AUTH_OTP_SECRET=
AUTH_PASSWORD_SALT_ROUNDS=12
AUTH_SESSION_TTL_HOURS=168
AUTH_OTP_TTL_MINUTES=10
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60

# Email OTP (Brevo Transactional Email API)
# Production: configure both values in Render; never commit credentials.
BREVO_API_KEY=
EMAIL_FROM=

# OCTOBOT AI provider (optional; configure one provider to enable model-backed replies)
AI_PROVIDER=gemini
AI_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Web
VITE_API_BASE_URL=http://localhost:4000/api/v1
