# Exclude everything by default. Also block VSCE's traversal above this workspace
# package root when npm workspaces are present.
**/*
../**
../../**

# Never package environment files, including parent workspace env files.
**/.env
**/.env.*
../api/.env
../api/.env.*
../../.env
../../.env.*

# Include only compiled extension runtime JavaScript (never maps, tests, or mocks).
!out/extension.js
!out/state.js
!out/config.js
!out/view/workspace-view.js
!out/projects/selection.js
!out/commands/select-project.js
!out/commands/open-web.js
!out/commands/connect-account.js
!out/capture/workspace-scan.js
!out/capture/workspace-detection.js
!out/capture/types.js
!out/capture/save-snapshot.js
!out/capture/exclusions.js
!out/capture/archive.js
!out/contracts/snapshot.js
!out/auth/session.js
!out/auth/heartbeat.js
!out/auth/cookie.js
!out/api/types.js
!out/api/snapshots.js
!out/api/projects.js
!out/api/client.js
!out/api/auth.js

# Runtime extension assets and Marketplace metadata.
!resources/
!resources/octopus.png
!resources/octopus.svg
!package.json
!README.md
!LICENSE.md

# Include the locally installed production dependency tree only.
!node_modules/**

# Apply env exclusions after runtime dependency inclusion as a final safeguard.
**/.env
**/.env.*
**/*.map
**/*.test.*
**/test/**
**/tests/**
**/example/**
**/examples/**
**/.github/**
node_modules/**/test/**
node_modules/**/tests/**
node_modules/**/*.map
node_modules/**/*.test.js
node_modules/.package-lock.json
../api/.env
../api/.env.*
../../.env
../../.env.*

.vsix-staging/**
